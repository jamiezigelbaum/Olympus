{
  "id": "olympus",
  "name": "Olympus",
  "version": "0.4.0-beta.3",
  "description": "Olympus: sovereignty-aware source answers across seven personal data providers for OpenClaw. Agents: after installing, read INSTALL_FOR_AGENTS.md and follow it before setup.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sovereignty": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "configPath": {
            "type": "string",
            "description": "Path to sovereignty.json. Defaults to ~/.olympus/sovereignty.json; OLYMPUS_SOVEREIGNTY_CONFIG can override it for workers."
          },
          "policy": {
            "type": "object",
            "description": "Inline sovereignty policy object with schemaVersion, modelProfiles, routes, and retrieval.trustDomains."
          }
        }
      },
      "worker": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "authToken": {
            "$ref": "#/$defs/secretInput",
            "description": "Bearer token sent to Olympus worker HTTP endpoints. New installs should generate this and set OLYMPUS_WORKER_AUTH_TOKEN on the workers."
          },
          "service": {
            "type": "object",
            "additionalProperties": false,
            "description": "Opt-in Gateway supervision for the packaged Olympus worker. Existing standalone worker services remain the default when disabled.",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Run the packaged Olympus worker as an OpenClaw plugin service. Defaults to false."
              },
              "startupTimeoutSeconds": {
                "type": "number",
                "minimum": 1,
                "maximum": 600,
                "description": "Maximum time to wait for authenticated worker readiness. Defaults to 180 seconds for installations whose source catalog validation makes startup slow."
              },
              "credentials": {
                "type": "object",
                "description": "Resolved provider credentials injected only into the native worker child. Keys are restricted at runtime to approved Olympus credential environment names; raw values should be supplied through Gateway SecretRefs.",
                "additionalProperties": {
                  "$ref": "#/$defs/secretInput"
                }
              },
              "runtimePath": {
                "type": "string",
                "description": "Optional absolute path to Bun. Omit to resolve an absolute Bun path from the Gateway environment."
              },
              "executablePath": {
                "type": "string",
                "description": "Optional absolute path to the packaged dist/cli.js worker entrypoint. Omit to use the copy beside the loaded plugin bundle."
              }
            }
          },
          "creditMonitor": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional native provider-credit monitoring; presently supports Venice billing.",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "venice"
                ]
              },
              "intervalSeconds": {
                "type": "integer",
                "minimum": 60,
                "maximum": 86400
              },
              "reportPath": {
                "type": "string",
                "description": "Absolute path for the private billing status report."
              },
              "pauseFile": {
                "type": "string",
                "description": "Optional absolute path for the existing Venice pause marker."
              },
              "credentials": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "VENICE_API_KEY": {
                    "$ref": "#/$defs/secretInput"
                  }
                }
              }
            }
          },
          "telegramCapture": {
            "type": "object",
            "additionalProperties": false,
            "description": "Opt-in Gateway supervision for the local read-only Telegram capture process.",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Run Telegram capture as an OpenClaw plugin service. Defaults to false."
              },
              "credentials": {
                "type": "object",
                "description": "Resolved Telethon application credentials. Only OLYMPUS_TELEGRAM_API_ID and OLYMPUS_TELEGRAM_API_HASH are accepted; supply raw values through Gateway SecretRefs.",
                "additionalProperties": false,
                "properties": {
                  "OLYMPUS_TELEGRAM_API_ID": {
                    "$ref": "#/$defs/secretInput"
                  },
                  "OLYMPUS_TELEGRAM_API_HASH": {
                    "$ref": "#/$defs/secretInput"
                  }
                }
              },
              "pythonPath": {
                "type": "string",
                "description": "Absolute path to an operator-provisioned Python interpreter with Telethon installed."
              },
              "sessionPath": {
                "type": "string",
                "description": "Optional absolute path to the existing authorized Telethon .session file. Native config overrides worker.env."
              },
              "stateDir": {
                "type": "string",
                "description": "Optional absolute capture state directory. Native config overrides worker.env."
              },
              "spoolDir": {
                "type": "string",
                "description": "Optional absolute append-only capture spool directory. Native config overrides worker.env."
              },
              "reportPath": {
                "type": "string",
                "description": "Optional absolute capture status report path. Native config overrides worker.env."
              }
            }
          },
          "whatsappCapture": {
            "type": "object",
            "additionalProperties": false,
            "description": "Opt-in Gateway supervision for an operator-provisioned native WhatsApp capture binary. Pairing remains a separate manual operation.",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Run native WhatsApp capture as an OpenClaw plugin service. Defaults to false."
              },
              "binaryPath": {
                "type": "string",
                "description": "Absolute path to the operator-provisioned Olympus WhatsApp capture binary. Required when enabled."
              },
              "stateDir": {
                "type": "string",
                "description": "Optional absolute state directory containing an existing paired session.db. Defaults to ~/.local/share/olympus/whatsapp-live."
              }
            }
          },
          "embeddingDrain": {
            "type": "object",
            "additionalProperties": false,
            "description": "Opt-in Gateway supervision for the packaged source embedding drain.",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Run the source embedding drain as an OpenClaw plugin service. Defaults to false."
              },
              "credentials": {
                "type": "object",
                "description": "Resolved Gemini embedding credentials. Only GEMINI_API_KEY and OLYMPUS_SOURCE_INDEX_GEMINI_API_KEY are accepted; supply raw values through Gateway SecretRefs.",
                "additionalProperties": false,
                "properties": {
                  "GEMINI_API_KEY": {
                    "$ref": "#/$defs/secretInput"
                  },
                  "OLYMPUS_SOURCE_INDEX_GEMINI_API_KEY": {
                    "$ref": "#/$defs/secretInput"
                  }
                }
              },
              "runtimePath": {
                "type": "string",
                "description": "Optional absolute path to Bun. Omit to resolve an absolute Bun path from the Gateway environment."
              },
              "environmentPath": {
                "type": "string",
                "description": "Optional absolute file of nonsecret drain settings, parsed as data. Defaults to the managed worker.env; credentials still come only from native SecretRefs."
              },
              "reportPath": {
                "type": "string",
                "description": "Optional absolute path for the existing source embedding drain report. Native config overrides worker.env."
              }
            }
          },
          "transcriptionCleanup": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional native scheduling of the existing stale transcription-temp sweep. Live-process reference checks are preserved.",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "bashPath": {
                "type": "string",
                "description": "Absolute Bash path; defaults to /bin/bash."
              },
              "tempRoot": {
                "type": "string",
                "description": "Absolute transcription-temp root; defaults to the OS temp directory."
              },
              "intervalSeconds": {
                "type": "integer",
                "minimum": 60,
                "maximum": 86400
              },
              "minAgeMinutes": {
                "type": "integer",
                "minimum": 1
              },
              "maxRuntimeSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            }
          },
          "scheduler": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enable the in-process Olympus worker scheduler."
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "gmail.email",
                    "google_drive.docs",
                    "dropbox.files",
                    "x.bookmarks",
                    "telegram.messages",
                    "whatsapp.personal.messages",
                    "readwise.library"
                  ]
                },
                "uniqueItems": true,
                "description": "Explicit source allowlist. A non-empty list is required when the scheduler is enabled."
              },
              "tickSeconds": {
                "type": "number",
                "minimum": 1,
                "description": "Scheduler tick cadence in seconds."
              },
              "syncIntervalSeconds": {
                "type": "number",
                "minimum": 1,
                "description": "Source sync interval in seconds."
              },
              "freshnessThresholdHours": {
                "type": "number",
                "minimum": 0,
                "description": "Freshness threshold before source data is considered stale."
              },
              "errorBackoffSeconds": {
                "type": "number",
                "minimum": 1,
                "description": "Backoff interval after transient scheduler errors."
              },
              "maxTransientRetries": {
                "type": "number",
                "minimum": 0,
                "description": "Maximum transient retry count before surfacing scheduler failure."
              }
            }
          }
        }
      },
      "identity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ownerName": {
            "type": "string",
            "description": "Human owner name used in assistant-facing prompts."
          },
          "assistantName": {
            "type": "string",
            "description": "Calling assistant name used in assistant-facing prompts."
          }
        }
      },
      "argus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "defaultLane": {
            "type": "string",
            "enum": [
              "fast",
              "deep"
            ],
            "description": "Default Argus lane."
          },
          "defaultProfile": {
            "type": "string",
            "enum": [
              "default_chat",
              "source_answer",
              "classification_fast",
              "embedding_secure_local",
              "vlm_document",
              "vlm_fast",
              "vlm_qwen36_27b",
              "vlm_qwen36_35b"
            ],
            "description": "Default Argus model profile."
          },
          "transport": {
            "type": "string",
            "enum": [
              "direct"
            ],
            "description": "Argus transport. v0.1 supports direct HTTP to a runtime-managed endpoint."
          },
          "requestTimeoutSeconds": {
            "type": "number",
            "minimum": 1,
            "description": "Request timeout for Argus model calls."
          },
          "lanes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fast": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "baseUrl": {
                    "type": "string",
                    "description": "OpenAI-compatible FAST lane base URL."
                  },
                  "model": {
                    "type": "string",
                    "description": "FAST lane model id."
                  },
                  "secretRef": {
                    "type": "string",
                    "description": "SecretRef for the FAST lane model provider credential."
                  }
                }
              },
              "deep": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "baseUrl": {
                    "type": "string",
                    "description": "OpenAI-compatible DEEP lane base URL."
                  },
                  "model": {
                    "type": "string",
                    "description": "DEEP lane model id."
                  },
                  "secretRef": {
                    "type": "string",
                    "description": "SecretRef for the DEEP lane model provider credential."
                  }
                }
              }
            }
          },
          "modelProfiles": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "default_chat": {
                "$ref": "#/$defs/argusModelProfile"
              },
              "source_answer": {
                "$ref": "#/$defs/argusModelProfile"
              },
              "classification_fast": {
                "$ref": "#/$defs/argusModelProfile"
              },
              "embedding_secure_local": {
                "$ref": "#/$defs/argusModelProfile"
              },
              "vlm_document": {
                "$ref": "#/$defs/argusModelProfile"
              },
              "vlm_fast": {
                "$ref": "#/$defs/argusModelProfile"
              },
              "vlm_qwen36_27b": {
                "$ref": "#/$defs/argusModelProfile"
              },
              "vlm_qwen36_35b": {
                "$ref": "#/$defs/argusModelProfile"
              }
            }
          }
        }
      },
      "email": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Enable the Gateway-local private email source worker."
          },
          "baseUrl": {
            "type": "string",
            "description": "Base URL for the private email source worker reachable from the OpenClaw Gateway host."
          },
          "requestTimeoutSeconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 600,
            "description": "Request timeout for private email lane calls. Keep at or below 600: a longer lane timer inside the OpenClaw Gateway fails every Olympus tool call with \"Async work scope is closed\" (observed on OpenClaw 2026.9.4)."
          }
        }
      },
      "sourceIndex": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Enable the public source answer, status, and search tools."
          },
          "corpusRegistry": {
            "$ref": "#/$defs/sourceCorpusRegistry"
          },
          "corpora": {
            "type": "array",
            "description": "Shorthand for sourceIndex.corpusRegistry.corpora with schemaVersion 1.",
            "items": {
              "$ref": "#/$defs/sourceCorpus"
            }
          },
          "ingestionExclusions": {
            "$ref": "#/$defs/sourceIngestionExclusions"
          },
          "ingestionExclusionsPath": {
            "type": "string",
            "description": "Path to a JSON file holding the ingestion exclusions. Defaults to ~/.olympus/sources/ingestion-exclusions.json."
          },
          "ingestionPolicies": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dropboxPersonal": {
                "type": "object",
                "additionalProperties": false,
                "description": "Dropbox personal ingestion policy wrapper or inline schemaVersion 1 policy.",
                "properties": {
                  "policyPath": {
                    "type": "string",
                    "description": "Path to a local Dropbox ingestion policy JSON file."
                  },
                  "policy": {
                    "$ref": "#/$defs/sourceIngestionPolicy"
                  },
                  "schemaVersion": {
                    "type": "number",
                    "enum": [
                      1
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "corpusId": {
                    "type": "string"
                  },
                  "roots": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/sourceIngestionRoot"
                    }
                  },
                  "rules": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/sourceIngestionRule"
                    }
                  },
                  "sync": {
                    "$ref": "#/$defs/sourceIngestionSync"
                  },
                  "content": {
                    "$ref": "#/$defs/sourceIngestionContent"
                  }
                }
              }
            }
          }
        }
      }
    },
    "$defs": {
      "secretInput": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec"
                ]
              },
              "provider": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "provider",
              "id"
            ]
          }
        ]
      },
      "argusModelProfile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "baseUrl": {
            "type": "string",
            "description": "OpenAI-compatible model-profile base URL."
          },
          "model": {
            "type": "string",
            "description": "Served model id for this model profile."
          },
          "secretRef": {
            "type": "string",
            "description": "SecretRef for this model profile provider credential."
          },
          "purpose": {
            "type": "string",
            "enum": [
              "chat",
              "text_reasoning",
              "classification",
              "embedding",
              "vision"
            ],
            "description": "Intended profile capability."
          }
        }
      },
      "sourceCorpusRegistry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "corpora": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceCorpus"
            }
          }
        }
      },
      "sourceCorpus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "corpusId": {
            "type": "string",
            "enum": [
              "secure_local.email.private",
              "internal.email",
              "public_safe.email",
              "public_safe.drive.docs",
              "internal.drive.docs",
              "secure_local.drive.docs",
              "internal.telegram.messages",
              "internal.readwise.library",
              "internal.x.bookmarks",
              "secure_local.dropbox.files",
              "secure_local.telegram.protected.messages",
              "secure_local.whatsapp.messages"
            ]
          },
          "sourceId": {
            "type": "string",
            "enum": [
              "gmail.email",
              "google_drive.docs",
              "dropbox.files",
              "x.bookmarks",
              "telegram.messages",
              "whatsapp.personal.messages",
              "readwise.library"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "gmail",
              "google_drive",
              "dropbox",
              "x",
              "telegram",
              "whatsapp",
              "readwise"
            ]
          },
          "family": {
            "type": "string",
            "enum": [
              "email",
              "file",
              "chat",
              "readwise",
              "x"
            ]
          },
          "trustDomain": {
            "type": "string",
            "enum": [
              "public_safe",
              "internal",
              "secure_local"
            ]
          },
          "activationMode": {
            "type": "string",
            "enum": [
              "lexical_only",
              "hybrid_shadow",
              "hybrid_primary"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "answer",
                "status",
                "sync",
                "search",
                "promotion_candidates"
              ]
            }
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "corpusId",
          "sourceId",
          "provider",
          "family",
          "trustDomain",
          "capabilities"
        ],
        "oneOf": [
          {
            "properties": {
              "corpusId": {
                "const": "secure_local.email.private"
              },
              "sourceId": {
                "const": "gmail.email"
              },
              "provider": {
                "const": "gmail"
              },
              "family": {
                "const": "email"
              },
              "trustDomain": {
                "const": "secure_local"
              },
              "capabilities": {
                "items": {
                  "enum": [
                    "answer",
                    "status",
                    "sync",
                    "search"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "corpusId": {
                "const": "internal.email"
              },
              "sourceId": {
                "const": "gmail.email"
              },
              "provider": {
                "const": "gmail"
              },
              "family": {
                "const": "email"
              },
              "trustDomain": {
                "const": "internal"
              },
              "capabilities": {
                "items": {
                  "enum": [
                    "answer",
                    "status",
                    "sync",
                    "search"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "corpusId": {
                "const": "public_safe.email"
              },
              "sourceId": {
                "const": "gmail.email"
              },
              "provider": {
                "const": "gmail"
              },
              "family": {
                "const": "email"
              },
              "trustDomain": {
                "const": "public_safe"
              },
              "capabilities": {
                "items": {
                  "enum": [
                    "answer",
                    "status",
                    "search"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "corpusId": {
                "const": "public_safe.drive.docs"
              },
              "sourceId": {
                "const": "google_drive.docs"
              },
              "provider": {
                "const": "google_drive"
              },
              "family": {
                "const": "file"
              },
              "trustDomain": {
                "const": "public_safe"
              },
              "capabilities": {
                "items": {
                  "enum": [
                    "answer",
                    "status",
                    "search"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "corpusId": {
                "const": "internal.drive.docs"
              },
              "sourceId": {
                "const": "google_drive.docs"
              },
              "provider": {
                "const": "google_drive"
              },
              "family": {
                "const": "file"
              },
              "trustDomain": {
                "const": "internal"
              },
              "capabilities": {
                "items": {
                  "enum": [
                    "answer",
                    "status",
                    "sync",
                    "search"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "corpusId": {
                "const": "secure_local.drive.docs"
              },
              "sourceId": {
                "const": "google_drive.docs"
              },
              "provider": {
                "const": "google_drive"
              },
              "family": {
                "const": "file"
              },
              "trustDomain": {
                "const": "secure_local"
              },
              "capabilities": {
                "items": {
                  "enum": [
                    "answer",
                    "status",
                    "sync",
                    "search"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "corpusId": {
                "const": "internal.telegram.messages"
              },
              "sourceId": {
                "const": "telegram.messages"
              },
              "provider": {
                "const": "telegram"
              },
              "family": {
                "const": "chat"
              },
              "trustDomain": {
                "const": "internal"
              },
              "capabilities": {
                "items": {
                  "enum": [
                    "answer",
                    "status",
                    "sync",
                    "search"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "corpusId": {
                "const": "internal.readwise.library"
              },
              "sourceId": {
                "const": "readwise.library"
              },
              "provider": {
                "const": "readwise"
              },
              "family": {
                "const": "readwise"
              },
              "trustDomain": {
                "const": "internal"
              },
              "capabilities": {
                "items": {
                  "enum": [
                    "answer",
                    "status",
                    "sync"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "corpusId": {
                "const": "internal.x.bookmarks"
              },
              "sourceId": {
                "const": "x.bookmarks"
              },
              "provider": {
                "const": "x"
              },
              "family": {
                "const": "x"
              },
              "trustDomain": {
                "const": "internal"
              },
              "capabilities": {
                "items": {
                  "enum": [
                    "answer",
                    "status",
                    "sync",
                    "search"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "corpusId": {
                "const": "secure_local.dropbox.files"
              },
              "sourceId": {
                "const": "dropbox.files"
              },
              "provider": {
                "const": "dropbox"
              },
              "family": {
                "const": "file"
              },
              "trustDomain": {
                "const": "secure_local"
              },
              "capabilities": {
                "items": {
                  "enum": [
                    "answer",
                    "status",
                    "sync",
                    "search",
                    "promotion_candidates"
                  ]
                }
              }
            }
