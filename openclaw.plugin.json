      "sourceIngestionExclusions": {
        "type": "object",
        "additionalProperties": false,
        "description": "Ingestion dispositions. Source-neutral: one shape for every file-storage connector, whether it names folders by path or by identity. An exclusion always wins over an approved scope, and over a metadata-only rule covering the same item, whatever order they are written in. An item that cannot be evaluated against this list is excluded rather than ingested.",
        "required": [
          "schemaVersion",
          "rules"
        ],
        "properties": {
          "schemaVersion": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceIngestionExclusionRule"
            }
          }
        }
      },
      "sourceIngestionExclusionRule": {
        "type": "object",
        "additionalProperties": false,
        "description": "One ingestion disposition. Names items by folder path prefix, by folder identity, or by a media criterion, for the sources listed. At least one of path_prefixes, folder_ids, or media is required. mode decides what happens to a matching item: exclude (never ingested) or metadata_only (indexed by title, path and date, content never read). Example: {\"id\": \"spirituality\", \"mode\": \"metadata_only\", \"sources\": [\"dropbox.personal\"], \"path_prefixes\": [\"/3 Resources/Spirituality\"], \"reason\": \"index_titles_only\"}",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable label for this rule. Previews and receipts are keyed by it, so counts stay comparable when the folders under it change. Letters, digits, dot, dash, and underscore only."
          },
          "mode": {
            "type": "string",
            "enum": [
              "exclude",
              "metadata_only"
            ],
            "description": "What happens to a matching item. exclude is the default and is what every rule written without this field means: never ingested, and removed by the purge if already stored. metadata_only admits the item with its title, path and timestamps and never reads its content: no extraction, no chunks, no embeddings, and an honest coverage gap naming this rule. Content already stored for such an item is removed by the metadata-only strip, which keeps the item row. An unrecognized value is refused when configuration is read, never defaulted."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Source ids this rule applies to, for example dropbox.personal or google_drive.personal. Omit or leave empty to exclude these folders from every source. REQUIRED when folder_ids is used: a folder id is minted by one provider and means nothing to another. A rule that names a source which cannot enforce any criterion the rule carries is refused when the gate is built, rather than silently matching nothing."
          },
          "path_prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Folder paths to exclude, together with everything beneath them. Matched on whole path segments and case-insensitively: /3 Resources/Books excludes that folder and its contents, but not a sibling named Bookshelf. For providers whose paths are real paths, such as Dropbox. Google Drive publishes no folder paths, so use folder_ids there."
          },
          "folder_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceIngestionExclusionFolder"
            },
            "description": "Folders to exclude by provider identity, together with everything beneath them at any depth. For providers that build paths from opaque folder ids rather than names, such as Google Drive. Identity survives a rename or a move, which a path prefix does not. A file reachable through an excluded folder is excluded even when it also sits under an ordinary one. Get an id with: bun run source-exclusions:resolve-folder -- <drive folder URL>"
          },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "description": "Match items by what they ARE rather than where they live: the concrete case is video over a size threshold, which no folder list can express. Provider-neutral, because a byte count and a file type are facts every file source publishes. At least one of extensions or mime_prefixes is required: a size-only rule cannot be answered for an item whose provider omits a size, so it would exclude every such item. The type and size halves are ANDed; entries within a half are ORed. A rule carrying media may not also carry path_prefixes or folder_ids, because that conjunction has two plausible readings and the unchecked one under-matches; write two rules instead. Example: {\"extensions\": [\".mp4\", \".mov\", \".avi\", \".mkv\", \".m4v\", \".mts\"], \"min_bytes\": 104857600}",
            "properties": {
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "File extensions, with or without the leading dot, compared case-insensitively against the last dot of the file name. archive.tar.gz is a .gz; holiday.mp4.txt is a .txt, not a video."
              },
              "mime_prefixes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Media-type prefixes such as video/ , for providers that publish a mime type and no useful extension."
              },
              "min_bytes": {
                "type": "number",
                "description": "Inclusive lower bound in bytes. 104857600 is 100 MiB."
              },
              "max_bytes": {
                "type": "number",
                "description": "Inclusive upper bound in bytes."
              }
            }
          },
          "reason": {
            "type": "string",
            "description": "Why this rule exists. Appears in previews and receipts, so keep it free of private detail."
          }
        }
      },
      "sourceIngestionExclusionFolder": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "description": "One folder named by provider identity. The name is never matched on. It is there so the file stays reviewable a year later, because a list of bare opaque ids is not.",
        "properties": {
          "id": {
            "type": "string",
            "description": "The provider's folder id, exactly as the provider spells it. Compared case-sensitively, unlike a path."
          },
          "name": {
            "type": "string",
            "description": "The folder's human name, for review. Documentation only: never used for matching, and it does not have to stay accurate."
          }
        }
      },
      "sourceIngestionPolicy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "source": {
            "type": "string"
          },
          "corpusId": {
            "type": "string"
          },
          "roots": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceIngestionRoot"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceIngestionRule"
            }
          },
          "sync": {
            "$ref": "#/$defs/sourceIngestionSync"
          },
          "content": {
            "$ref": "#/$defs/sourceIngestionContent"
          }
        }
      },
      "sourceIngestionRoot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "approved_scope_key": {
            "type": "string"
          },
          "default_action": {
            "type": "string",
            "enum": [
              "full_extract",
              "metadata_only",
              "on_demand"
            ]
          }
        }
      },
      "sourceIngestionRule": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "match": {
            "$ref": "#/$defs/sourceIngestionMatch"
          },
          "action": {
            "type": "string",
            "enum": [
              "full_extract",
              "metadata_only",
              "on_demand"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "sourceIngestionMatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mime_type_prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path_contains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path_prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "sourceIngestionSync": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cadence": {
            "type": "string",
            "enum": [
              "manual",
              "continuous"
            ]
          },
          "max_entries_per_pass": {
            "type": "number",
            "minimum": 1
          },
          "max_pages_per_pass": {
            "type": "number",
            "minimum": 1
          }
        }
      },
      "sourceIngestionContent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "default_extractor_kind": {
            "type": "string"
          },
          "default_extractor_version": {
            "type": "string"
          },
          "plan_limit": {
            "type": "number",
            "minimum": 1
          },
          "batch_size": {
            "type": "number",
            "minimum": 1
          }
        }
      }
    }
  },
