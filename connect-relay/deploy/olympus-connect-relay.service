# Olympus connect relay. See docs/design/relay.md, "Runbook".
# Install: /etc/systemd/system/olympus-connect-relay.service
# Code:    /opt/olympus-connect-relay/connect-relay  (copy of this repo's connect-relay/ at a released SHA)
# Config:  /etc/olympus-connect-relay/relay.env      (non-secret; see relay.env.example)
# Secrets: /etc/olympus-connect-relay/credentials/    (root-owned 0600; passed with LoadCredential)

[Unit]
Description=Olympus connect relay (SNI pass-through)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=olympus-relay
Group=olympus-relay
WorkingDirectory=/opt/olympus-connect-relay/connect-relay
EnvironmentFile=/etc/olympus-connect-relay/relay.env
LoadCredential=cloudflare-api-token:/etc/olympus-connect-relay/credentials/cloudflare-api-token
LoadCredential=control-key.pem:/etc/olympus-connect-relay/credentials/control-key.pem
Environment=RELAY_CLOUDFLARE_API_TOKEN_FILE=%d/cloudflare-api-token
Environment=RELAY_CONTROL_KEY_PATH=%d/control-key.pem
Environment=RELAY_REGISTRY_PATH=/var/lib/olympus-connect-relay/registry.jsonl
StateDirectory=olympus-connect-relay
StateDirectoryMode=0700
ExecStart=/usr/local/bin/bun server/main.ts
Restart=always
RestartSec=2
LimitNOFILE=65536

# Bind :443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Hardening.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute is left off: Bun's JIT needs writable executable memory.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectProc=invisible
ProcSubset=pid
MemoryMax=1G
TasksMax=512
UMask=0077

[Install]
WantedBy=multi-user.target
