# /etc/olympus-connect-relay/relay.env — non-secret relay configuration.
RELAY_ZONE=connect.olympusplugin.ai
RELAY_CONTROL_HOST=relay.connect.olympusplugin.ai
# Data connections (installs answering `open`); the control certificate must name both hosts.
RELAY_DATA_HOST=data.relay.connect.olympusplugin.ai
# Defaults to :: (dual stack) when RELAY_PUBLIC_IPV6 is set, else 0.0.0.0.
# RELAY_LISTEN_HOST=::
RELAY_LISTEN_PORT=443
# Public certificate chain for RELAY_CONTROL_HOST and RELAY_DATA_HOST (its key is a systemd credential).
RELAY_CONTROL_CERT_PATH=/etc/olympus-connect-relay/control-cert.pem
RELAY_CLOUDFLARE_ZONE_ID=replace-with-zone-id
RELAY_PUBLIC_IPV4=replace-with-relay-ipv4
# RELAY_PUBLIC_IPV6=replace-with-relay-ipv6
