{
  "schemaVersion": 1,
  "modelProfiles": {
    "built-in-embedding": {
      "provider": "built-in",
      "trust": "local",
      "model": "embeddinggemma-2-onnx-UNPINNED",
      "purpose": "embedding"
    },
    "venice-private": {
      "provider": "venice",
      "trust": "encrypted_cloud",
      "baseUrl": "https://api.venice.ai/api/v1",
      "model": "kimi-k3",
      "secretRef": "store:venice.api_key",
      "purpose": "analyst"
    },
    "cloud-openclaw-infer": {
      "provider": "openclaw-infer",
      "trust": "standard_cloud",
      "purpose": "analyst"
    }
  },
  "routes": {
    "secure_local": { "pool": { "members": ["venice-private"] } },
    "internal": {
      "analyst": [
        "cloud-openclaw-infer"
      ]
    },
    "public_safe": {
      "analyst": [
        "cloud-openclaw-infer"
      ]
    }
  },
  "retrieval": {
    "trustDomains": {
      "secure_local": {
        "minimumExecutionTrust": "encrypted_cloud",
        "allowedEmbeddingTrust": [
          "local",
          "encrypted_cloud"
        ],
        "embeddingProfile": "built-in-embedding",
        "allowCloudQuery": false,
        "activationMode": "hybrid_shadow",
        "secureHandling": "answerable"
      },
      "internal": {
        "minimumExecutionTrust": "standard_cloud",
        "allowedEmbeddingTrust": [
          "local",
          "standard_cloud"
        ],
        "embeddingProfile": "built-in-embedding",
        "allowCloudQuery": true,
        "activationMode": "hybrid_shadow"
      },
      "public_safe": {
        "minimumExecutionTrust": "standard_cloud",
        "allowedEmbeddingTrust": [
          "local",
          "standard_cloud"
        ],
        "embeddingProfile": "built-in-embedding",
        "allowCloudQuery": true,
        "activationMode": "hybrid_shadow"
      }
    }
  }
}
