export function create<Source>ConnectorStore(
  dbPath = default<Source>ConnectorStoreDbPath(),
): LocalConnectorStore {
  return new LocalConnectorStore({
    dbPath,
    corpusId: <SOURCE>_CORPUS_ID,
    family: '<family>',
    trustDomain: 'internal', // TODO: must match classify()'s domain.
  });
}

export function default<Source>ConnectorStoreDbPath(
  env: Record<string, string | undefined> = process.env,
): string {
  const configured = env.OLYMPUS_SOURCE_INDEX_<SOURCE>_CONNECTOR_STORE_DB_PATH?.trim();
  if (configured) return configured;
  const dataHome = env.XDG_DATA_HOME?.trim() || join(homedir(), '.local', 'share');
  return join(dataHome, 'openclaw', 'olympus', '<source>-connector-store.sqlite');
}

// --- Normalization -----------------------------------------------------------

function rawItemFrom<Source>(
  raw: unknown, // TODO: your provider's item type.
  account: string,
  fetchedAt: string,
): RawItem | undefined {
  // TODO: pull provider id, title, author/sender, tags, locator, timestamps,
  // and text. Return undefined for an item with no stable provider id rather
  // than inventing one.
  const providerItemId = 'TODO';
  const title = 'TODO';
  const text = '';
  const conversationScope = `TODO:${providerItemId}`; // e.g. `document:<id>`; omit if flat.

  return {
    identity: {
      family: '<family>',
      provider: <SOURCE>_PROVIDER,
      accountScope: account,
      providerItemId,
      // The store's uniqueness key is
      // (provider, account_scope, normalized_conversation, provider_item_id).
      providerThreadId: conversationScope,
      providerConversationId: conversationScope,
      localItemId: `${account}:${providerItemId}`,
      // TODO: the provider's updated-at, when it has one. This is the change signal.
      // sourceVersion: updatedAt,
    },
    mimeType: 'text/plain; charset=utf-8',
    // metadata_only when there is no text — never a fabricated empty string.
    content: text ? { kind: 'text', text } : { kind: 'metadata_only' },
    metadata: Object.freeze({
      // Keys the shared store actually reads. Everything else is carried but
      // unindexed; do not invent competing spellings.
      title,
      // locatorUri / pathDisplay / url  -> the citation locator
      // authoredAt / sentAt / clientModifiedAt -> authored time
      // updatedAt / serverModifiedAt -> updated time
      // senderId, senderLabel, senderIsOwner -> sender identity
      // aliases, identityAliases, searchText -> retrieval surface
      // deleted: true -> tombstone signal
      // reactions -> validated aggregate; omit to preserve, [] to clear
      contentHash: createHash('sha256').update(JSON.stringify({ text, title })).digest('hex'),
    }),
    fetchedAt,
  };
}

// --- Cursor ------------------------------------------------------------------

/**
 * Cheap local validation of a resume cursor. A checkpoint carried across days
 * or store generations must be provable before it is spent on provider I/O; an
 * unparseable one falls back to a fresh traversal instead of failing a run.
 */
export function is<Source>ConnectorCursor(value: string | undefined): boolean {
  if (!value) return false;
  try {
    decodeCursor(value);
    return true;
  } catch {
    return false;
  }
}

function encodeCursor(cursor: <Source>Cursor): string {
  return `${CURSOR_PREFIX}${Buffer.from(JSON.stringify(cursor)).toString('base64url')}`;
}

function decodeCursor(value: string | undefined): <Source>Cursor {
  if (!value) return {};
  if (value.length > MAX_CURSOR_LENGTH || !value.startsWith(CURSOR_PREFIX)) {
    throw new TypeError('<Source> connector cursor is invalid.');
  }
  try {
    const parsed = JSON.parse(
      Buffer.from(value.slice(CURSOR_PREFIX.length), 'base64url').toString('utf8'),
    ) as { pageToken?: unknown };
    if (
      parsed.pageToken !== undefined
      && (
        typeof parsed.pageToken !== 'string'
        || !parsed.pageToken.trim()
        || parsed.pageToken.length > MAX_CURSOR_LENGTH
      )
    ) {
      throw new Error('invalid');
    }
    return { ...(typeof parsed.pageToken === 'string' ? { pageToken: parsed.pageToken.trim() } : {}) };
  } catch {
    throw new TypeError('<Source> connector cursor is invalid.');
  }
}

/** A provider that repeats a page token must not become an infinite loop. */
function assertNewProviderPage(seen: Set<string>, cursor: <Source>Cursor): void {
  const key = cursor.pageToken ?? '';
  if (seen.has(key)) throw new Error('<Source> connector pagination cursor repeated.');
  seen.add(key);
}

// --- Bounded helpers ---------------------------------------------------------

function dedupeItems(items: RawItem[]): RawItem[] {
  return [...new Map(items.map((item) => [
    `${item.identity.providerConversationId ?? ''}\0${item.identity.providerItemId}`,
    item,
  ])).values()];
}

function boundedPageSize(value: number | undefined): number {
  if (value === undefined) return DEFAULT_<SOURCE>_CONNECTOR_PAGE_SIZE;
  if (!Number.isSafeInteger(value) || value < 1 || value > 100) {
    throw new TypeError('<Source> connector page size must be an integer from 1 to 100.');
  }
  return value;
}

function normalizeOptionalLimit(value: number | undefined): number | undefined {
  if (value === undefined) return undefined;
  return positiveInteger(value, '<Source> connector list limit');
}

function positiveInteger(value: number, label: string): number {
  if (!Number.isSafeInteger(value) || value <= 0) {
    throw new TypeError(`${label} must be a positive integer.`);
  }
  return value;
}

function requireAccount(value: string): string {
  if (!value || value.length > MAX_ACCOUNT_LENGTH) {
    throw new TypeError('<Source> account must be bounded and non-empty.');
  }
  return value;
}

function validDate(value: Date): Date {
  if (!Number.isFinite(value.getTime())) {
    throw new TypeError('<Source> connector timestamp must be valid.');
  }
  return value;
}

function nextUtcDay(date: Date): string {
  return new Date(Date.UTC(
    date.getUTCFullYear(),
    date.getUTCMonth(),
    date.getUTCDate() + 1,
  )).toISOString();
}
